# Runtime image for the ChatGPT Web connector.
# Build this image locally; the running container is intentionally offline.
FROM golang:1.24-bookworm AS go-toolchain

FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV MCP_CLIENT_DOCKER=true
ENV PATH="/usr/local/go/bin:/go/bin:${PATH}"
ENV GOPATH=/go
ENV GOTOOLCHAIN=local

# Copy only the Go toolchain into the Node runtime image. Go modules remain a
# read-only host mount at runtime; the container still has no network access.
COPY --from=go-toolchain /usr/local/go /usr/local/go
RUN mkdir -p /go/bin /go/pkg/mod

WORKDIR /usr/src/app

# The telemetry-contract dependency is a local package, so it must be present
# before npm resolves package-lock.json.
COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm rebuild @vscode/ripgrep --no-audit --no-fund

COPY dist ./dist

CMD ["node", "/usr/src/app/dist/index.js", "--no-onboarding"]
